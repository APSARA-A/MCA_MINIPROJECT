DJANGO_SECRET_KEY=change-me-to-a-long-random-string-of-at-least-50-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Preliminary whole-blood MVP policy; confirm with the collection facility.
MATCHING_MIN_AGE=18
MATCHING_MAX_AGE=60
MATCHING_MALE_INTERVAL_DAYS=90
MATCHING_FEMALE_INTERVAL_DAYS=120
# MATCHING_MIN_WEIGHT_KG=50

# Keep the normal application database unless intentionally using isolated demo data.
# LIFELINK_SQLITE_PATH=/absolute/path/to/lifelink-demo.sqlite3
LIFELINK_DEMO_MODE=false
# Production: DEBUG=False requires a unique random secret (50+ characters).
# Secure cookies and HTTPS redirect then default on. Configure TLS first.
# DJANGO_SECURE_SSL_REDIRECT=True
# Enable HSTS only after validating HTTPS for your domain:
# DJANGO_SECURE_HSTS_SECONDS=31536000
